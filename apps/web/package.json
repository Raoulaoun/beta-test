{
  "name": "manager-test-web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/unit/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:bundle": "esbuild scripts/migrate.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/migrate.cjs --log-level=warning",
    "db:migrate": "npm run db:bundle && node dist/migrate.cjs",
    "test:db": "node --test --experimental-strip-types --test-concurrency=1 tests/db/*.test.ts",
    "jobs:bundle": "esbuild scripts/retention.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/retention.cjs --log-level=warning",
    "jobs:retention": "npm run jobs:bundle && node dist/retention.cjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "libphonenumber-js": "1.13.15",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.25.12",
    "tsx": "4.20.6",
    "typescript": "5.9.2"
  }
}
